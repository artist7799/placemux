# PlaceMux Platform Environment Configuration Reference

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=placemux_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/placemux_db?schema=public

# Node.js Backend Server
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Microservices Communication
AI_SERVICE_URL=http://localhost:8000
